---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Live Drawing Made Simple">
	<main class="relative overflow-hidden">
		<!-- Background Glow -->
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-[#863BFF]/20 blur-[120px] -z-10 rounded-full opacity-50"></div>

		<!-- Navigation -->
		<nav class="max-w-7xl mx-auto px-6 py-8 flex justify-between items-center">
			<div class="flex items-center gap-2">
				<div class="w-8 h-8 bg-[#863BFF] rounded-lg flex items-center justify-center">
					<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
				</div>
				<span class="text-xl font-bold tracking-tight outfit">PadSync</span>
			</div>
			<div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-400">
				<a href="#features" class="hover:text-white transition-colors">Features</a>
				<a href="#demo" class="hover:text-white transition-colors">Demo</a>
				<a href="#download" class="px-5 py-2 bg-white text-black rounded-full hover:bg-gray-200 transition-colors">Download</a>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="max-w-7xl mx-auto px-6 pt-20 pb-32 text-center relative">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#863BFF]/10 border border-[#863BFF]/20 text-[#B48CFF] text-xs font-bold uppercase tracking-widest mb-8">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#863BFF] opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-[#863BFF]"></span>
				</span>
				Now in Beta
			</div>
			
			<h1 class="text-6xl md:text-8xl font-bold tracking-tighter mb-6 leading-[0.9] outfit">
				Turn your phone into a <br/>
				<span class="text-gradient">live writing pad.</span>
			</h1>
			
			<p class="max-w-2xl mx-auto text-lg md:text-xl text-gray-400 mb-12 leading-relaxed">
				Zero lag. No cloud bloat. Just pure, real-time drawing from your mobile screen directly to your desktop. Perfect for online teaching, math, and quick diagrams.
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
				<a href="#download" class="w-full sm:w-auto px-8 py-4 bg-[#863BFF] text-white rounded-xl font-semibold shadow-[0_0_40px_-10px_rgba(134,59,255,0.5)] hover:bg-[#7627FF] transition-all hover:scale-105 active:scale-95">
					Download for Windows
				</a>
				<a href="#feedback" class="w-full sm:w-auto px-8 py-4 glass-card rounded-xl font-semibold hover:bg-white/5 transition-all">
					Give Feedback
				</a>
			</div>

			<!-- Hero Image -->
			<div class="relative max-w-5xl mx-auto px-4">
				<div class="aspect-video glass-card rounded-3xl overflow-hidden shadow-[0_0_100px_-20px_rgba(134,59,255,0.3)] relative group border border-white/10">
					<img src="/hero-preview.png" alt="PadSync in action" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
					<div class="absolute inset-0 bg-gradient-to-t from-[#0A0B14] via-transparent to-transparent opacity-40 z-10"></div>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section id="features" class="max-w-7xl mx-auto px-6 py-32 border-t border-white/5">
			<div class="grid md:grid-cols-3 gap-8">
				<div class="p-8 glass-card rounded-2xl">
					<div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400 mb-6">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-3 outfit">Zero Latency</h3>
					<p class="text-gray-400 leading-relaxed">Engineered for speed. See your strokes appear on your PC as fast as you can draw them on your phone.</p>
				</div>
				<div class="p-8 glass-card rounded-2xl">
					<div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center text-purple-400 mb-6">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-3 outfit">Privacy First</h3>
					<p class="text-gray-400 leading-relaxed">No cloud storage, no accounts, no bloat. Your data stays between your devices on your local network.</p>
				</div>
				<div class="p-8 glass-card rounded-2xl">
					<div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center text-emerald-400 mb-6">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-3 outfit">Works on any Phone</h3>
					<p class="text-gray-400 leading-relaxed">No app store download required. Scan the QR code with your phone camera and start writing instantly.</p>
				</div>
			</div>
		</section>

		<!-- Download Section -->
		<section id="download" class="max-w-7xl mx-auto px-6 py-32 border-t border-white/5 text-center">
			<h2 class="text-4xl font-bold mb-6 outfit">Get PadSync for your desktop.</h2>
			<p class="text-gray-400 mb-12 max-w-2xl mx-auto leading-relaxed">
				Download the desktop application to start hosting drawing rooms. Your phone connects to this app to turn into a live writing pad.
			</p>
			
			<div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto text-left">
				<div class="p-8 glass-card rounded-2xl border border-white/10 flex flex-col justify-between">
					<div>
						<div class="w-12 h-12 bg-[#863BFF]/10 rounded-xl flex items-center justify-center text-[#863BFF] mb-6">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1V11.7H0V3.449zm0 9.151h9.75v9.6L0 20.551V12.6zm10.65-10.5L24 0v11.7h-13.35V2.1zM10.65 12.6H24V24l-13.35-1.95V12.6z"/></svg>
						</div>
						<h3 class="text-xl font-bold mb-2 outfit">Windows</h3>
						<p class="text-gray-400 mb-6">Optimized for Windows 10 & 11. Low latency and system-wide hotkeys.</p>
					</div>
					<a href="#" class="inline-flex items-center justify-center px-6 py-3 bg-white text-black rounded-xl font-semibold hover:bg-gray-200 transition-colors">
						Download .exe (Beta)
					</a>
				</div>
				
				<div class="p-8 glass-card rounded-2xl border border-white/10 opacity-60 flex flex-col justify-between">
					<div>
						<div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center text-white mb-6">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.96.95-2.04 1.9-3.26 1.9-1.2 0-1.59-.73-2.94-.73-1.35 0-1.8.71-2.94.73-1.14.02-2.31-1-3.27-1.93-1.96-1.9-3.48-5.38-3.48-8.42 0-4.66 3.01-7.12 5.86-7.12 1.5 0 2.9.89 3.82.89.92 0 2.61-1.07 4.39-1.07 2.37 0 4.14 1.21 5.09 2.58-2.02 1.22-2.39 3.51-2.39 5.58 0 2.47 1.51 4.5 3.32 5.29-.6 1.45-1.4 2.87-2.2 4.1zm-4.38-16.7c.96-1.12 1.61-2.68 1.61-4.24 0-.22-.03-.43-.07-.63-1.53.06-3.39 1.02-4.49 2.3-.99 1.14-1.85 2.74-1.85 4.3 0 .22.04.45.08.65 1.7.13 3.42-.87 4.72-2.38z"/></svg>
						</div>
						<h3 class="text-xl font-bold mb-2 outfit">macOS</h3>
						<p class="text-gray-400 mb-6">Support for Apple Silicon and Intel Macs. Coming soon to all users.</p>
					</div>
					<button disabled class="cursor-not-allowed inline-flex items-center justify-center px-6 py-3 bg-white/10 text-white/50 rounded-xl font-semibold">
						Coming Soon
					</button>
				</div>
			</div>
		</section>

		<!-- Feedback Section -->
		<section id="feedback" class="max-w-3xl mx-auto px-6 py-32 text-center">
			<h2 class="text-4xl font-bold mb-6 outfit">Share your feedback.</h2>
			<p class="text-gray-400 mb-10 leading-relaxed">Help us make PadSync better. Whether it's a feature request, a bug report, or just a friendly hello, we'd love to hear from you.</p>
			
			<form class="flex flex-col gap-4">
				<input type="email" placeholder="Your email (optional)" class="bg-white/5 border border-white/10 rounded-xl px-5 py-4 focus:outline-none focus:border-[#863BFF] transition-colors" />
				<textarea placeholder="Your message..." rows="4" class="bg-white/5 border border-white/10 rounded-xl px-5 py-4 focus:outline-none focus:border-[#863BFF] transition-colors resize-none"></textarea>
				<button type="submit" class="w-full px-8 py-4 bg-[#863BFF] text-white rounded-xl font-semibold shadow-[0_0_40px_-10px_rgba(134,59,255,0.5)] hover:bg-[#7627FF] transition-all">Send Feedback</button>
			</form>
		</section>

		<!-- Footer -->
		<footer class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5 text-center text-sm text-gray-500">
			<div class="flex items-center justify-center gap-2 mb-4 opacity-50">
				<div class="w-5 h-5 bg-white/20 rounded-md flex items-center justify-center">
					<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
				</div>
				<span class="font-bold tracking-tight outfit">PadSync</span>
			</div>
			<p>&copy; {new Date().getFullYear()} PadSync. Build for speed, built for flow.</p>
		</footer>
	</main>
</Layout>
